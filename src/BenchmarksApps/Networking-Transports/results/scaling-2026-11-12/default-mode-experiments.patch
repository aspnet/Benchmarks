+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+
+namespace Microsoft.AspNetCore.Server.Kestrel.Transport.Networking.Shared;
+
+/// <summary>
+/// A multi-producer, single-consumer queue of commands for one worker thread. It reuses two arrays and swaps them under a short lock,
+/// so enqueueing allocates nothing in steady state. <see cref="System.Collections.Concurrent.ConcurrentQueue{T}"/> drops a 32-slot segment
+/// after every 32 items, which at two commands per request was about half of the transport's per-request allocation.
+/// </summary>
+internal sealed class CommandQueue<T>
+{
+    private readonly Lock _gate = new();
+    private T[] _incoming = new T[128];
+    private T[] _draining = new T[128];
+    private int _incomingCount;
+    private int _drainCount;
+    private int _drainIndex;
+
+    /// <summary>Gets whether no command is waiting. Call it from the consumer only.</summary>
+    internal bool IsEmpty => _drainIndex == _drainCount && Volatile.Read(ref _incomingCount) == 0;
+
+    internal void Enqueue(T command)
+    {
+        lock (_gate)
+        {
+            if (_incomingCount == _incoming.Length)
+            {
+                Array.Resize(ref _incoming, _incoming.Length * 2);
+            }
+            _incoming[_incomingCount++] = command;
+        }
+    }
+
+    /// <summary>Takes the oldest command. Call it from the consumer only.</summary>
+    internal bool TryDequeue(out T command)
+    {
+        if (_drainIndex == _drainCount)
+        {
+            lock (_gate)
+            {
+                if (_incomingCount == 0)
+                {
+                    command = default!;
+                    return false;
+                }
+                // The drained array is empty (each slot is cleared when taken), so it becomes the next incoming array.
+                (_incoming, _draining) = (_draining, _incoming);
+                _drainCount = _incomingCount;
+                _drainIndex = 0;
+                _incomingCount = 0;
+            }
+        }
+        command = _draining[_drainIndex];
+        _draining[_drainIndex++] = default!;
+        return true;
+    }
+}
