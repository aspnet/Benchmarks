<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <NoWarn>$(NoWarn);CA1416;SYSLIB5007</NoWarn>
  </PropertyGroup>

  <!-- The prototype assemblies and native shims are copied into <project>\libs before the build, the same way as for the server projects. -->
  <ItemGroup>
    <Reference Include="Microsoft.AspNetCore.Server.Kestrel.Transport.Networking">
      <HintPath>$(MSBuildProjectDirectory)\libs\Microsoft.AspNetCore.Server.Kestrel.Transport.Networking.dll</HintPath>
    </Reference>
    <Reference Include="NetworkTransport.Primitives">
      <HintPath>$(MSBuildProjectDirectory)\libs\NetworkTransport.Primitives.dll</HintPath>
    </Reference>

    <None Include="libs\*.so" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Crank.EventSources" Version="0.1.0-alpha.20501.1" />
  </ItemGroup>

</Project>
