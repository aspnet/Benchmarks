<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- GenHTTP.* and ioxide.* packages (genhttp-ioxide) only exist on nuget.org, not on
         Crank's own curated dotnet feeds. Crank's PatchNuGetConfig (Microsoft.Crank.Agent/
         Startup.cs) always inserts a leading <clear /> to block inherited nuget.org access
         from machine/user configs, then patches in its own feeds alongside whatever is
         already here - so listing nuget.org explicitly in this vendored file (deployed via
         options.buildFiles, which preserves the original filename) keeps it available
         after that patch.
         This must be named exactly "NuGet.config" - PatchNuGetConfig only recognizes the
         casings nuget.config/NuGet.config/NuGet.Config - so it lives in its own subfolder
         rather than the flat scenarios/assets/ naming used elsewhere in this repo. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
